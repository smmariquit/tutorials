---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const teach = [
 'Mathematics',
 'Computer Science',
 'Python & Data',
 'Physics & Science',
];
---

<Layout title="Tutoring Social Card">
 <div class="social-wrapper">
 <div class="social-card" id="capture-area">
 <div class="card-header">
 <div class="header-text">
 <div class="badge">Accepting New Students</div>
 <h1>Tutoring: Math, CS &amp; Programming</h1>
 <p class="subtitle">Simonee Ezekiel Mariquit</p>
 <p class="tagline">UPLB Computer Science student, builder, and workshop speaker.</p>
 </div>
 <img class="header-photo" src="/simonee.jpg" alt="Simonee Ezekiel Mariquit" width="150" height="150" />
 </div>

 <div class="card-body">
 <h3>What I teach</h3>
 <ul class="pill-list">
 {teach.map(t => (
 <li>{t}</li>
 ))}
 </ul>
 <p class="approach">Hands-on and project-based. We build real things, not just work through theory: from exam prep to shipping actual projects.</p>
 </div>

 <div class="card-pricing">
 <h3>Pricing</h3>
 <div class="rates">
 <div class="rate-box">
 <span class="label">Solo online</span>
 <span class="price">₱350-500<span>/hr</span></span>
 </div>
 <div class="rate-box highlight">
 <span class="label">Group (max 3)</span>
 <span class="price">₱250-400<span>/hr per head</span></span>
 </div>
 <div class="rate-box">
 <span class="label">Intensive pack</span>
 <span class="price">₱3,500-5,000<span>/10 hrs</span></span>
 </div>
 </div>
 </div>

 <div class="card-contact">
 <h3>Get in touch</h3>
 <div class="contact-row">
 <span class="contact">semariquit@gmail.com</span>
 <span class="contact">Simonee Ezekiel Mariquit on Facebook</span>
 </div>
 </div>
 </div>
 </div>
</Layout>

<style>
 :global(body) {
 background: linear-gradient(135deg, #e8f1f8 0%, #f0efeb 50%, #f5f2ec 100%);
 display: flex;
 align-items: center;
 justify-content: center;
 min-height: 100vh;
 margin: 0;
 padding: 20px;
 }

.social-wrapper {
 position: relative;
 width: 1080px;
 height: 1080px;
 display: flex;
 align-items: center;
 justify-content: center;
 background: linear-gradient(160deg, #dce8f5 0%, #f0efeb 45%, #e6e2dc 100%);
 overflow: hidden;
}

/* subtle in-action teaching cover behind the card */
.social-wrapper::before {
 content: '';
 position: absolute;
 inset: 0;
 background: url('/teaching.jpg') center/cover no-repeat;
 opacity: 0.14;
 pointer-events: none;
}

.social-card {
 position: relative;
 z-index: 1;
 background: #ffffff;
 width: 1020px;
 height: 1020px;
 border-radius: 24px;
 border: 1px solid #c9c4ba;
 box-shadow:
 0 1px 2px rgba(44, 42, 38, 0.04),
 0 12px 32px rgba(44, 42, 38, 0.18);
 padding: 56px 56px 52px;
 display: flex;
 flex-direction: column;
 justify-content: space-between;
 }

.card-header {
 display: flex;
 align-items: flex-start;
 justify-content: space-between;
 gap: 24px;
 }

.header-text { flex: 1; }

.header-photo {
 flex-shrink: 0;
 width: 150px;
 height: 150px;
 border-radius: 22px;
 object-fit: cover;
 border: 1px solid #c9c4ba;
 box-shadow: 0 4px 16px rgba(44, 42, 38, 0.14);
 }

.badge {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 background: #dce8f5;
 color: #1f4f8b;
 border: 1px solid #bcd1e6;
 padding: 8px 16px;
 border-radius: 999px;
 font-weight: 600;
 font-size: 1.25rem;
 width: fit-content;
 margin-bottom: 18px;
 }

.card-header h1 {
 font-size: 4rem;
 font-weight: 800;
 letter-spacing: -0.03em;
 line-height: 1.05;
 color: #1a1510;
 margin-bottom: 16px;
 }

.subtitle {
 font-size: 1.6rem;
 color: #1a1510;
 font-weight: 700;
 margin-bottom: 12px;
 }

.tagline {
 font-size: 1.35rem;
 color: #5c5850;
 margin-bottom: 8px;
 }

.card-body h3,
.card-pricing h3,
.card-contact h3 {
 font-size: 1.15rem;
 font-weight: 700;
 color: #8a857c;
 text-transform: uppercase;
 letter-spacing: 0.12em;
 margin-bottom: 14px;
 margin-top: 18px;
 }

.card-body h3:first-of-type,
.card-pricing h3:first-of-type,
.card-contact h3:first-of-type {
 margin-top: 0;
 }

.pill-list {
 display: grid;
 grid-template-columns: repeat(2, 1fr);
 gap: 14px;
 list-style: none;
 padding: 0;
 margin: 0;
 }

.pill-list li {
 background: #f5f2ec;
 border: 1px solid #d8d3c9;
 color: #1a1510;
 padding: 18px 14px;
 border-radius: 16px;
 font-size: 1.35rem;
 font-weight: 700;
 text-align: center;
 line-height: 1.35;
 }

.approach {
 font-size: 1.3rem;
 color: #5c5850;
 line-height: 1.5;
 margin-top: 18px;
 }

.card-pricing {
 margin-top: 8px;
 }

.rates {
 display: grid;
 grid-template-columns: repeat(3, 1fr);
 gap: 16px;
 }

.rate-box {
 background: #f5f2ec;
 border: 1px solid #d8d3c9;
 border-radius: 18px;
 padding: 24px 22px;
 display: flex;
 flex-direction: column;
 gap: 8px;
 }

.rate-box.highlight {
 background: #dce8f5;
 border-color: #2563a8;
 }

.label {
 font-size: 1.1rem;
 font-weight: 700;
 color: #5c5850;
 }

.highlight.label {
 color: #1f4f8b;
 }

.price {
 font-size: 1.85rem;
 font-weight: 800;
 color: #1a1510;
 display: flex;
 align-items: baseline;
 flex-wrap: wrap;
 gap: 4px;
 line-height: 1.1;
 }

.price span {
 font-size: 1.15rem;
 color: #5c5850;
 font-weight: 600;
 }

.card-contact {
 margin-top: auto;
 }

.contact-row {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 14px;
 }

.contact {
 background: #1f2933;
 color: #ffffff;
 padding: 16px 14px;
 border-radius: 16px;
 font-size: 1.15rem;
 font-weight: 700;
 text-align: center;
 }
</style>
