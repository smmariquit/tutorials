---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Tutoring Social Card">
  <div class="social-wrapper">
    <div class="social-card" id="capture-area">
      <div class="card-header">
        <div class="badge">Accepting New Students</div>
        <h1>Tutoring: Math, CS &amp; Programming</h1>
        <p class="subtitle">Simonee Ezekiel Mariquit</p>
        <p class="tagline">UPLB Computer Science Student, Builder &amp; Workshop Speaker</p>
      </div>

      <div class="card-body">
        <h3>What I teach</h3>
        <ul class="pill-list">
          <li>K-12 &amp; CET review</li>
          <li>CS fundamentals</li>
          <li>Data structures &amp; algorithms</li>
          <li>Web programming</li>
          <li>Python, JS/TS, C/C++, SQL</li>
          <li>Pandas, ML basics</li>
        </ul>

        <h3>How to book</h3>
        <ul class="pill-list">
          <li>Email me</li>
          <li>Simonee Ezekiel Mariquit on Facebook</li>
        </ul>
      </div>

      <div class="card-footer">
        <div class="rates">
          <div class="rate-box">
            <span class="label">Solo Online</span>
            <span class="price">₱350-500<span>/hr</span></span>
          </div>
          <div class="rate-box highlight">
            <span class="label">Group Online (max 3)</span>
            <span class="price">₱250-400<span>/hr per head</span></span>
          </div>
        </div>

        <div class="contact-row">
          <span class="contact">semariquit@gmail.com</span>
          <span class="contact">tutor.stimmie.dev</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(body) {
    background: linear-gradient(135deg, #e8f1f8 0%, #f0efeb 50%, #f5f2ec 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    margin: 0;
    padding: 20px;
  }

  .social-wrapper {
    width: 1080px;
    height: 1080px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, #dce8f5 0%, #f0efeb 45%, #e6e2dc 100%);
  }

  .social-card {
    background: #ffffff;
    width: 1020px;
    height: 1020px;
    border-radius: 24px;
    border: 1px solid #c9c4ba;
    box-shadow:
      0 1px 2px rgba(44, 42, 38, 0.04),
      0 8px 24px rgba(44, 42, 38, 0.08);
    padding: 52px 52px 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #dce8f5;
    color: #1f4f8b;
    border: 1px solid #bcd1e6;
    padding: 6px 14px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1.05rem;
    width: fit-content;
  }

  .card-header h1 {
    font-size: 3.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #1a1510;
    margin-top: 14px;
    margin-bottom: 12px;
  }

  .subtitle {
    font-size: 1.4rem;
    color: #4a453f;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .tagline {
    font-size: 1.1rem;
    color: #6b655d;
  }

  .card-body h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #8a857c;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 10px;
    margin-top: 16px;
  }

  .card-body h3:first-of-type {
    margin-top: 0;
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0 0 10px;
  }

  .pill-list li {
    background: #f5f2ec;
    border: 1px solid #d8d3c9;
    color: #2c2a26;
    padding: 9px 13px;
    border-radius: 999px;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .card-footer {
    border-top: 1px solid #d8d3c9;
    padding-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rates {
    display: flex;
    gap: 14px;
  }

  .rate-box {
    flex: 1;
    background: #f5f2ec;
    border: 1px solid #d8d3c9;
    border-radius: 14px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rate-box.highlight {
    background: #dce8f5;
    border-color: #2563a8;
  }

  .label {
    font-size: 1.05rem;
    font-weight: 700;
    color: #5c5850;
  }

  .highlight .label {
    color: #1f4f8b;
  }

  .price {
    font-size: 1.8rem;
    font-weight: 800;
    color: #1a1510;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .price span {
    font-size: 0.95rem;
    color: #5c5850;
    font-weight: 600;
  }

  .contact-row {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .contact {
    background: #1f2933;
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 1.05rem;
    font-weight: 700;
  }
</style>
