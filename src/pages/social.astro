---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Social Media Card">
  <div class="social-wrapper">
    <div class="social-card" id="capture-area">
      <div class="card-header">
        <div class="badge">Accepting New Students</div>
        <h1>Tutoring: Math, CS &amp; Programming</h1>
        <p class="subtitle">By Simonee — UPLB CS Student, Builder &amp; Workshop Speaker</p>
      </div>

      <div class="card-body">
        <div class="grid-section">
          <div class="column">
            <h3>What I Teach</h3>
            <ul>
              <li><strong>K-12 &amp; CET Review:</strong> Math, Science, UPCAT/ACET prep</li>
              <li><strong>CS Fundamentals:</strong> Data Structures, Algos, Theory</li>
              <li><strong>Tech Stack:</strong> Python, JS/TS, C/C++, React, SQL</li>
              <li><strong>Data Science:</strong> Pandas, Machine Learning, Stats</li>
            </ul>
          </div>
          
          <div class="column">
            <h3>Why me?</h3>
            <ul>
              <li>100+ hours of tutoring experience</li>
              <li>BS Computer Science @ UP Los Baños</li>
              <li>16+ workshops taught nationwide</li>
              <li>Actual experience building web apps</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="card-footer">
        <div class="rates">
          <div class="rate-box">
            <span class="label">Solo</span>
            <span class="price">₱400<span>/hr</span></span>
          </div>
          <div class="rate-box highlight">
            <span class="label">Group (Max 3)</span>
            <span class="price">₱300<span>/hr per head</span></span>
          </div>
        </div>
        
        <div class="contact-info">
          <p>Online via Discord / Zoom | F2F in Biñan or Los Baños</p>
          <div class="links">
            <span class="link">fb.com/stimmieuwu</span>
            <span class="link">tutor.stimmie.dev</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Reset background for social capture */
  :global(body) {
    background: #e9ecef;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    margin: 0;
    padding: 20px;
  }

  .social-wrapper {
    /* Fixed 1:1 Aspect Ratio optimized for Instagram/Facebook square posts */
    width: 1080px;
    height: 1080px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e9ecef;
  }

  .social-card {
    background: #ffffff;
    width: 1020px;
    height: 1020px;
    border-radius: 32px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    padding: 50px 60px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--border);
  }

  .badge {
    display: inline-block;
    background: #e7f5ff;
    color: #1864ab;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 20px;
    border: 1px solid #a5d8ff;
  }

  .card-header h1 {
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }

  .subtitle {
    font-size: 1.6rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .grid-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin: 12px 0;
  }

  .column h3 {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text);
  }

  .column ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .column li {
    font-size: 1.3rem;
    color: var(--text-muted);
    position: relative;
    padding-left: 28px;
    line-height: 1.4;
  }

  .column li::before {
    content: '✓';
    color: var(--success);
    font-weight: 800;
    position: absolute;
    left: 0;
    top: 0;
  }

  .column li strong {
    color: var(--text);
  }

  .card-footer {
    border-top: 2px solid var(--border);
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .rates {
    display: flex;
    gap: 24px;
  }

  .rate-box {
    flex: 1;
    background: var(--bg-card);
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 20px 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 8px;
  }

  .rate-box.highlight {
    background: #f8fbff;
    border-color: var(--accent);
  }

  .label {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .highlight .label {
    color: var(--accent);
  }

  .price {
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--text);
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .price span {
    font-size: 1.2rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .contact-info {
    text-align: center;
  }

  .contact-info p {
    font-size: 1.4rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 16px;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 24px;
  }

  .link {
    background: var(--text);
    color: #fff;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
</style>
