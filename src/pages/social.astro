---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Social Media Card">
  <div class="social-wrapper">
    <div class="social-card" id="capture-area">
      <div class="card-header">
        <div class="badge">Accepting New Students</div>
        <h1>Tutoring: Math, CS &amp; Programming</h1>
        <p class="subtitle">Simonee Ezekiel Mariquit — UPLB Computer Science Student, Builder &amp; Workshop Speaker</p>
        <p class="tagline">100+ hours of tutoring &mdash; clear, practical, straight to the point.</p>
      </div>

      <div class="card-body">
        <h3>What I teach</h3>
        <ul class="pill-list">
          <li>K-12 &amp; CET review</li>
          <li>CS fundamentals</li>
          <li>Data structures &amp; algorithms</li>
          <li>Web programming</li>
          <li>Python, JS/TS, C/C++, SQL</li>
          <li>Pandas, ML basics</li>
        </ul>

        <h3>How to book</h3>
        <ul class="pill-list">
          <li>Email me</li>
          <li>Simonee Ezekiel Mariquit on Facebook</li>
        </ul>
      </div>

      <div class="card-footer">
        <div class="rates">
          <div class="rate-box">
            <span class="label">Solo Online</span>
            <span class="price">₱350–500<span>/hr</span></span>
          </div>
          <div class="rate-box highlight">
            <span class="label">Group Online (max 3)</span>
            <span class="price">₱250–400<span>/hr per head</span></span>
          </div>
        </div>

        <div class="contact-row">
          <span class="contact">semariquit@gmail.com</span>
          <span class="contact">tutor.stimmie.dev</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(body) {
    background: #f0efeb;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    margin: 0;
    padding: 20px;
  }

  .social-wrapper {
    width: 1080px;
    height: 1080px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0efeb;
  }

  .social-card {
    background: #fafaf8;
    width: 1020px;
    height: 1020px;
    border-radius: 20px;
    border: 1px solid #ddd9d0;
    box-shadow: 0 1px 3px rgba(44, 42, 38, 0.06);
    padding: 56px 56px 52px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .badge {
    display: inline-block;
    background: #dce8f5;
    color: #1f4f8b;
    border: 1px solid #c2d6ee;
    padding: 6px 12px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1.1rem;
    width: fit-content;
  }

  .card-header h1 {
    font-size: 3.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #2c2a26;
    margin-top: 16px;
    margin-bottom: 14px;
  }

  .subtitle {
    font-size: 1.45rem;
    color: #5c5850;
    font-weight: 500;
  }

  .tagline {
    font-size: 1.15rem;
    color: #5c5850;
    margin-top: 10px;
  }

  .card-body h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #8a857c;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
    margin-top: 18px;
  }

  .card-body h3:first-of-type {
    margin-top: 0;
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
  }

  .pill-list li {
    background: #f0efeb;
    border: 1px solid #ddd9d0;
    color: #2c2a26;
    padding: 10px 14px;
    border-radius: 999px;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .card-footer {
    border-top: 1px solid #ddd9d0;
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .rates {
    display: flex;
    gap: 16px;
  }

  .rate-box {
    flex: 1;
    background: #f0efeb;
    border: 1px solid #ddd9d0;
    border-radius: 12px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rate-box.highlight {
    background: #dce8f5;
    border-color: #2563a8;
  }

  .label {
    font-size: 1.1rem;
    font-weight: 700;
    color: #5c5850;
  }

  .highlight .label {
    color: #1f4f8b;
  }

  .price {
    font-size: 1.9rem;
    font-weight: 800;
    color: #2c2a26;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .price span {
    font-size: 1rem;
    color: #5c5850;
    font-weight: 600;
  }

  .contact-row {
    display: flex;
    justify-content: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .contact {
    background: #2c2a26;
    color: #fff;
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 1.1rem;
    font-weight: 700;
  }
</style>
