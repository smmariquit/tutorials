---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Tutoring Social Card">
 <div class="social-wrapper">
 <div class="social-card" id="capture-area">
 <div class="card-header">
 <div class="badge">Accepting New Students</div>
 <h1>Tutoring: Math, CS &amp; Programming</h1>
 <p class="subtitle">Simonee Ezekiel Mariquit</p>
 <p class="tagline">UPLB Computer Science Student, Builder & Workshop Speaker</p>
 </div>

 <div class="card-body">
 <h3>What I teach</h3>
 <ul class="pill-list">
 <li>Algebra &amp; Trigonometry</li>
 <li>Geometry</li>
 <li>Physics</li>
 <li>General Science</li>
 <li>Computer Science</li>
 <li>Python &amp; Data</li>
 </ul>
 </div>

 <div class="card-pricing">
 <h3>Pricing</h3>
 <div class="rates">
 <div class="rate-box">
 <span class="label">Solo online</span>
 <span class="price">₱350-500<span>/hr</span></span>
 </div>
 <div class="rate-box highlight">
 <span class="label">Group (max 3)</span>
 <span class="price">₱250-400<span>/hr per head</span></span>
 </div>
 </div>
 </div>

 <div class="card-contact">
 <h3>Get in touch</h3>
 <div class="contact-row">
 <span class="contact">semariquit@gmail.com</span>
 <span class="contact">Simonee Ezekiel Mariquit on Facebook</span>
 </div>
 </div>
 </div>
 </div>
</Layout>

<style>
 :global(body) {
 background: linear-gradient(135deg, #e8f1f8 0%, #f0efeb 50%, #f5f2ec 100%);
 display: flex;
 align-items: center;
 justify-content: center;
 min-height: 100vh;
 margin: 0;
 padding: 20px;
 }

.social-wrapper {
 width: 1080px;
 height: 1080px;
 display: flex;
 align-items: center;
 justify-content: center;
 background: linear-gradient(160deg, #dce8f5 0%, #f0efeb 45%, #e6e2dc 100%);
 }

.social-card {
 background: #ffffff;
 width: 1020px;
 height: 1020px;
 border-radius: 24px;
 border: 1px solid #c9c4ba;
 box-shadow:
 0 1px 2px rgba(44, 42, 38, 0.04),
 0 12px 32px rgba(44, 42, 38, 0.1);
 padding: 56px 56px 52px;
 display: flex;
 flex-direction: column;
 justify-content: space-between;
 }

.badge {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 background: #dce8f5;
 color: #1f4f8b;
 border: 1px solid #bcd1e6;
 padding: 8px 16px;
 border-radius: 999px;
 font-weight: 600;
 font-size: 1.25rem;
 width: fit-content;
 margin-bottom: 18px;
 }

.card-header h1 {
 font-size: 4rem;
 font-weight: 800;
 letter-spacing: -0.03em;
 line-height: 1.05;
 color: #1a1510;
 margin-bottom: 16px;
 }

.subtitle {
 font-size: 1.6rem;
 color: #1a1510;
 font-weight: 700;
 margin-bottom: 6px;
 }

.tagline {
 font-size: 1.35rem;
 color: #5c5850;
 margin-bottom: 8px;
 }

.card-body h3,
.card-pricing h3,
.card-contact h3 {
 font-size: 1.15rem;
 font-weight: 700;
 color: #8a857c;
 text-transform: uppercase;
 letter-spacing: 0.12em;
 margin-bottom: 14px;
 margin-top: 18px;
 }

.card-body h3:first-of-type,
.card-pricing h3:first-of-type,
.card-contact h3:first-of-type {
 margin-top: 0;
 }

.pill-list {
 display: grid;
 grid-template-columns: repeat(3, 1fr);
 gap: 14px;
 list-style: none;
 padding: 0;
 margin: 0;
 }

.pill-list li {
 background: #f5f2ec;
 border: 1px solid #d8d3c9;
 color: #1a1510;
 padding: 18px 14px;
 border-radius: 16px;
 font-size: 1.35rem;
 font-weight: 700;
 text-align: center;
 line-height: 1.35;
 }

.card-pricing {
 margin-top: 8px;
 }

.rates {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 16px;
 }

.rate-box {
 background: #f5f2ec;
 border: 1px solid #d8d3c9;
 border-radius: 18px;
 padding: 24px 22px;
 display: flex;
 flex-direction: column;
 gap: 8px;
 }

.rate-box.highlight {
 background: #dce8f5;
 border-color: #2563a8;
 }

.label {
 font-size: 1.15rem;
 font-weight: 700;
 color: #5c5850;
 }

.highlight.label {
 color: #1f4f8b;
 }

.price {
 font-size: 2.4rem;
 font-weight: 800;
 color: #1a1510;
 display: flex;
 align-items: baseline;
 gap: 6px;
 line-height: 1;
 }

.price span {
 font-size: 1.15rem;
 color: #5c5850;
 font-weight: 600;
 }

.card-contact {
 margin-top: auto;
 }

.contact-row {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 14px;
 }

.contact {
 background: #1f2933;
 color: #ffffff;
 padding: 16px 14px;
 border-radius: 16px;
 font-size: 1.15rem;
 font-weight: 700;
 text-align: center;
 }
</style>
